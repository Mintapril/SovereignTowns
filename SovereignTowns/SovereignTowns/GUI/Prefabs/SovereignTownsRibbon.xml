                        </ListPanel>
                      </Children>
                    </BrushWidget>

                  </Children>
                </SovereignTownsFloatingPanelWidget>
              </Children>
            </BrushWidget>

          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
