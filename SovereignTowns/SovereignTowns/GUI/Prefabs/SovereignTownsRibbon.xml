                                         VerticalAlignment="Center"
                                         MarginTop="20"
                                         MarginBottom="20"
                                         AlignmentAxis="Vertical"
                                         Handle="VerticalScrollbarHandle"
                                         MaxValue="100"
                                         MinValue="0">
                          <Children>
                            <Widget WidthSizePolicy="Fixed"
                                    HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="4"
                                    HorizontalAlignment="Center"
                                    Sprite="MPLobby\CustomServer\lobby_slider_bed"
                                    Brush.AlphaFactor="0.4" />
                            <ImageWidget Id="VerticalScrollbarHandle"
                                         WidthSizePolicy="Fixed"
                                         HeightSizePolicy="Fixed"
                                         SuggestedWidth="8"
                                         SuggestedHeight="10"
                                         HorizontalAlignment="Center"
                                         Brush="FaceGen.Scrollbar.Handle" />
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </BrushWidget>

                    <BrushWidget HeightSizePolicy="Fixed"
                                 WidthSizePolicy="Fixed"
                                 SuggestedHeight="70"
                                 SuggestedWidth="430"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 MarginBottom="-8">
                      <Children>
                        <ListPanel WidthSizePolicy="CoverChildren"
                                   HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   LayoutImp.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <ButtonWidget WidthSizePolicy="Fixed"
                                          HeightSizePolicy="Fixed"
                                          SuggestedWidth="180"
                                          SuggestedHeight="44"
                                          Brush="Recruitment.Popup.DoneButton"
                                          Command.Click="ExecuteClose"
                                          MarginRight="24">
                              <Children>
                                <RichTextWidget WidthSizePolicy="CoverChildren"
                                                HeightSizePolicy="CoverChildren"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Brush="Recruitment.Popup.Done.Text"
                                                Text="@CloseText" />
                              </Children>
                            </ButtonWidget>
                            <ButtonWidget WidthSizePolicy="Fixed"
                                          HeightSizePolicy="Fixed"
                                          SuggestedWidth="180"
                                          SuggestedHeight="44"
                                          Brush="Recruitment.Popup.DoneButton"
