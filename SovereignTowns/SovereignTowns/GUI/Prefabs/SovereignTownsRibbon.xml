                                                            HeightSizePolicy="CoverChildren"
                                                            MarginTop="4"
                                                            Brush="SPOptions.OptionName.Text"
                                                            Color="#FF6060FF"
                                                            Text="@RatioSumWarning" />
                                          </Children>
                                        </ListPanel>

