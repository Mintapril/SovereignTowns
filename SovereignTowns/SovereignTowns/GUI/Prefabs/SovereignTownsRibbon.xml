                                                                            HeightSizePolicy="CoverChildren"
                                                                            SuggestedWidth="110"
                                                                            MarginLeft="10"
                                                                            VerticalAlignment="Center"
                                                                            Brush="SPOptions.OptionName.Text"
                                                                            Text="@SettlementTypeBadge" />
