      <VisualState PositionXOffset="1070" State="Retracted" />
      <VisualState PositionXOffset="-32" State="Expanded" />
    </VisualDefinition>
  </VisualDefinitions>

  <Window>
    <Widget DoNotAcceptEvents="true"
            WidthSizePolicy="CoverChildren"
            HeightSizePolicy="CoverChildren"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Sprite="BlankWhiteSquare_9"
            Color="#999999FF"
            AlphaFactor="0.0">
      <Children>
        <Widget DoNotAcceptEvents="true"
                Id="Overlay"
                VisualDefinition="Menu"
                WidthSizePolicy="Fixed"
                HeightSizePolicy="Fixed"
                SuggestedWidth="1120"
                SuggestedHeight="820"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Sprite="BlankWhiteSquare_9"
                Color="#999999FF"
                AlphaFactor="0.0"
                PositionXOffset="1070"
                PositionYOffset="0">
          <Children>

            <ButtonWidget Id="ExtendButton"
                          WidthSizePolicy="Fixed"
                          HeightSizePolicy="Fixed"
                          SuggestedHeight="122"
                          SuggestedWidth="52"
