                          VerticalAlignment="Top"
                          DoNotPassEventsToChildren="true"
                          UpdateChildrenStates="true"
                          MarginTop="80"
                          MarginLeft="0"
                          PositionXOffset="0"
                          HintText="Sovereign Towns">
              <Children>
                <BrushWidget Id="ExtendButtonArrow"
                             WidthSizePolicy="Fixed"
                             HeightSizePolicy="Fixed"
                             SuggestedWidth="30"
                             SuggestedHeight="30"
                             VerticalAlignment="Center"
                             MarginBottom="15"
                             MarginLeft="20"
                             Brush="GameMenu.Extend.Button.Arrow" />
              </Children>
            </ButtonWidget>

            <BrushWidget WidthSizePolicy="StretchToParent"
                         HeightSizePolicy="StretchToParent"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Brush="Frame1Brush"
                         MarginLeft="60">
              <Children>

                <Widget WidthSizePolicy="Fixed"
                        HeightSizePolicy="Fixed"
                        SuggestedWidth="500"
                        SuggestedHeight="135"
                        HorizontalAlignment="Center"
                        PositionYOffset="-35"
                        Sprite="StdAssets\tabbar_popup"
                        IsDisabled="true">
                  <Children>
                    <RichTextWidget WidthSizePolicy="CoverChildren"
                                    HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Center"
                                    MarginTop="-50"
                                    VerticalAlignment="Center"
                                    Brush="Recruitment.Popup.Title.Text"
                                    Brush.FontSize="35"
                                    IsDisabled="true"
                                    Text="@Title" />
                  </Children>
                </Widget>

                <Widget WidthSizePolicy="Fixed"
                        HeightSizePolicy="Fixed"
                        SuggestedWidth="24"
                        SuggestedHeight="350"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        MarginRight="-33"
                        Sprite="StdAssets\game_menu_hinges" />

                <SovereignTownsFloatingPanelWidget WidthSizePolicy="StretchToParent"
                                                   HeightSizePolicy="StretchToParent"
                                                   HorizontalAlignment="Left"
                                                   MarginLeft="0"
                                                   MarginTop="27"
                                                   MarginBottom="27"
                                                   MarginRight="0"
                                                   Sprite="BlankWhiteSquare_9"
                                                   Color="#999999FF"
                                                   AlphaFactor="0.0"
                                                   Overlay="..\..\..\Overlay"
                                                   ExtendButtonWidget="..\..\ExtendButton"
                                                   ExtendButtonArrowWidget="..\..\ExtendButton\ExtendButtonArrow">
                  <Children>

                    <Widget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed"
                            VerticalAlignment="Top"
                            SuggestedHeight="74">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="Fixed"
                                VerticalAlignment="Bottom"
                                SuggestedHeight="7"
                                Sprite="SPGeneral\TownManagement\title_divider" />
                        <RichTextWidget WidthSizePolicy="CoverChildren"
                                        HeightSizePolicy="CoverChildren"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MarginTop="16"
                                        Brush="TownManagement.Description.Title.Text"
                                        Brush.FontSize="22"
                                        Text="@Title" />
                      </Children>
                    </Widget>

                    <BrushWidget Id="ContentWidget"
                                 WidthSizePolicy="StretchToParent"
                                 HeightSizePolicy="StretchToParent"
                                 VerticalAlignment="Top"
                                 MarginLeft="10"
                                 MarginRight="10"
                                 MarginTop="80"
                                 MarginBottom="88"
                                 Brush="InnerFrameShadow1Brush"
                                 ClipContents="true">
                      <Children>
                        <Widget WidthSizePolicy="Fixed"
                                HeightSizePolicy="StretchToParent"
                                SuggestedWidth="7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Sprite="SPGeneral\TownManagement\vertical_divider"
                                AlphaFactor="0.7"
                                VerticalFlip="true" />

                        <ScrollablePanel Id="ScrollablePanel"
                                         WidthSizePolicy="StretchToParent"
                                         HeightSizePolicy="StretchToParent"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         AutoHideScrollBarHandle="true"
                                         AutoHideScrollBars="false"
                                         ClipRect="MyClipRect"
                                         InnerPanel="MyClipRect\InnerList"
                                         VerticalScrollbar="..\VerticalScrollbar">
                          <Children>
                            <Widget Id="MyClipRect"
                                    WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Center"
                                    ClipContents="true">
                              <Children>
                                <ListPanel Id="InnerList"
                                           WidthSizePolicy="StretchToParent"
                                           HeightSizePolicy="CoverChildren"
                                           MarginLeft="28"
                                           MarginRight="34"
                                           MarginTop="20"
                                           MarginBottom="20"
                                           LayoutImp.LayoutMethod="VerticalBottomToTop">
                                  <Children>

                                    <ListPanel WidthSizePolicy="StretchToParent"
                                               HeightSizePolicy="CoverChildren"
                                               LayoutImp.LayoutMethod="VerticalBottomToTop">
                                      <Children>
                                        <Widget WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="CoverChildren"
                                                MarginTop="4"
                                                MarginBottom="10">
                                          <Children>
                                            <RichTextWidget WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="CoverChildren"
                                                            Brush="SPOptions.Description.Title.Text"
                                                            Text="@FeaturesHeader" />
                                            <ImageWidget WidthSizePolicy="StretchToParent"
                                                         HeightSizePolicy="Fixed"
                                                         SuggestedHeight="2"
                                                         VerticalAlignment="Bottom"
                                                         MarginTop="30"
                                                         Brush="SPOptions.CollapserLine" />
                                          </Children>
                                        </Widget>

                                        <ListPanel DataSource="{ToggleOptions}"
                                                   WidthSizePolicy="StretchToParent"
                                                   HeightSizePolicy="CoverChildren"
                                                   LayoutImp.LayoutMethod="VerticalBottomToTop">
