                                <RichTextWidget WidthSizePolicy="CoverChildren"
                                                HeightSizePolicy="CoverChildren"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Brush="Recruitment.Popup.Done.Text"
                                                Text="@SaveText" />
                              </Children>
                            </ButtonWidget>
