<Prefab>
  <Window>
    <!-- Finance table row: 4 columns (Col1–Col4). Used for both summary tables (Col3/Col4 empty)
         and the recent-transactions table. When IsTotal is true, a gold bottom-border accent
         is shown to visually separate the total row. Bound to FinanceRowVM. -->
    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
               StackLayout.LayoutMethod="VerticalBottomToTop">
      <Children>

        <!-- Gold total-row accent line (visible only when IsTotal) -->
        <Widget IsVisible="@IsTotal"
                WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                SuggestedHeight="1"
                Sprite="BlankWhiteSquare_9" Color="#c8a165FF" AlphaFactor="0.8"
                MarginBottom="1" />

        <!-- Row content -->
        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                   VerticalAlignment="Center"
                   MarginTop="2" MarginBottom="2">
          <Children>

            <!-- Col1: category or time -->
            <TextWidget Brush="SPOptions.OptionName.Text" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                        SuggestedWidth="200"
                        Text="@Col1"
                        Color="#cdba8cFF"
                        VerticalAlignment="Center" />

            <!-- Col2: amount (summary) or category (recent) -->
            <TextWidget Brush="SPOptions.OptionName.Text" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                        SuggestedWidth="120"
                        Text="@Col2"
                        Color="#ecdfb9FF"
                        VerticalAlignment="Center" />

            <!-- Col3: amount (recent only; empty for summary rows) -->
            <TextWidget Brush="SPOptions.OptionName.Text" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                        SuggestedWidth="100"
                        Text="@Col3"
                        Color="#f4e4bcFF"
                        VerticalAlignment="Center" />

            <!-- Col4: note (recent only; empty for summary rows) -->
            <TextWidget Brush="SPOptions.OptionName.Text" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        Text="@Col4"
                        Color="#cdba8cFF"
                        VerticalAlignment="Center" />

          </Children>
        </ListPanel>

      </Children>
    </ListPanel>
  </Window>
</Prefab>
