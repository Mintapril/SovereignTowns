<Prefab>
  <Window>
    <!-- 全屏遮罩 + 深色背景。Sprite/Color 用法见 Native EscapeMenu.xml:10 -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.92">
      <Children>

        <!-- 居中主容器：垂直 ListPanel，顶部对齐，留边距 -->
        <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                   SuggestedWidth="1100"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   StackLayout.LayoutMethod="VerticalBottomToTop"
                   MarginTop="30" MarginBottom="30">
          <Children>

            <!-- 4. 正文：左侧 Tab 导轨 + 右侧内容区 -->
            <ListPanel Id="Body"
                       WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                       StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>

                <!-- ── 左列：Tab 按钮 + 活动日志 ── -->
                <ListPanel Id="LeftRail"
                           WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                           SuggestedWidth="180"
                           StackLayout.LayoutMethod="VerticalBottomToTop"
                           MarginRight="8">
                  <Children>

                    <!-- 活动日志区（占余下空间） -->
                    <Widget Id="ActivityLogArea"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            MarginTop="4">
                      <Children>

                        <!-- 日志标题 -->
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    Text="@ActivityLogLabel"
                                    VerticalAlignment="Top"
                                    MarginBottom="4" />

                        <!-- 可滚动日志列表 -->
                        <Widget Id="LogScrollContainer"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                MarginTop="20">
                          <Children>

                            <ScrollablePanel Id="LogScrollPanel"
                                             WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                             InnerPanel="LogClipRect\LogInnerPanel"
                                             ClipRect="LogClipRect"
                                             VerticalScrollbar="..\LogScrollbarHolder\LogScrollbar"
                                             AutoHideScrollBars="true">
                              <Children>
                                <Widget Id="LogClipRect"
                                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        ClipContents="true">
                                  <Children>
                                    <ListPanel Id="LogInnerPanel"
                                               DataSource="{LogEntries}"
                                               WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                               VerticalAlignment="Top"
                                               StackLayout.LayoutMethod="VerticalBottomToTop">
                                      <ItemTemplate>
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                                                   MarginBottom="2">
                                          <Children>
                                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                        Text="@Timestamp"
                                                        VerticalAlignment="Center"
                                                        MarginRight="4" />
                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                        Text="@Message"
                                                        VerticalAlignment="Center" />
                                          </Children>
                                        </ListPanel>
                                      </ItemTemplate>
                                    </ListPanel>
                                  </Children>
                                </Widget>
                              </Children>
                            </ScrollablePanel>

                            <Widget Id="LogScrollbarHolder"
                                    WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Right">
                              <Children>
                                <ScrollbarWidget Id="LogScrollbar"
                                                 WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                                 SuggestedWidth="10"
                                                 AlignmentAxis="Vertical"
                                                 Handle="LogScrollbarHandle"
                                                 MinValue="0" MaxValue="100">
                                  <Children>
                                    <Widget Id="LogScrollbarHandle"
                                            WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                            SuggestedWidth="10" SuggestedHeight="20"
                                            HorizontalAlignment="Center"
                                            Sprite="BlankWhiteSquare_9"
                                            Color="#B8960CFF" />
                                  </Children>
                                </ScrollbarWidget>
                              </Children>
                            </Widget>

                          </Children>
                        </Widget>

                      </Children>
                    </Widget>

                    <!-- Tab 按钮（VerticalBottomToTop → 01 在顶部） -->
                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteSelectTab5"
                                  WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                  SuggestedHeight="40"
                                  MarginBottom="2">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                                   VerticalAlignment="Center">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="4"
                                    Sprite="BlankWhiteSquare_9" Color="#B8960CFF"
                                    IsVisible="@IsTab5Active" />
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="06 " VerticalAlignment="Center" MarginLeft="6" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@Tab5Label" VerticalAlignment="Center" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteSelectTab4"
                                  WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                  SuggestedHeight="40"
                                  MarginBottom="2">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                                   VerticalAlignment="Center">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="4"
                                    Sprite="BlankWhiteSquare_9" Color="#B8960CFF"
                                    IsVisible="@IsTab4Active" />
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="05 " VerticalAlignment="Center" MarginLeft="6" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@Tab4Label" VerticalAlignment="Center" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteSelectTab3"
                                  WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                  SuggestedHeight="40"
                                  MarginBottom="2">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                                   VerticalAlignment="Center">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="4"
                                    Sprite="BlankWhiteSquare_9" Color="#B8960CFF"
                                    IsVisible="@IsTab3Active" />
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="04 " VerticalAlignment="Center" MarginLeft="6" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@Tab3Label" VerticalAlignment="Center" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteSelectTab2"
                                  WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                  SuggestedHeight="40"
                                  MarginBottom="2">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                                   VerticalAlignment="Center">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="4"
                                    Sprite="BlankWhiteSquare_9" Color="#B8960CFF"
                                    IsVisible="@IsTab2Active" />
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="03 " VerticalAlignment="Center" MarginLeft="6" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@Tab2Label" VerticalAlignment="Center" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteSelectTab1"
                                  WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                  SuggestedHeight="40"
                                  MarginBottom="2">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                                   VerticalAlignment="Center">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="4"
                                    Sprite="BlankWhiteSquare_9" Color="#B8960CFF"
                                    IsVisible="@IsTab1Active" />
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="02 " VerticalAlignment="Center" MarginLeft="6" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@Tab1Label" VerticalAlignment="Center" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteSelectTab0"
                                  WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                  SuggestedHeight="40"
                                  MarginBottom="2">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                                   VerticalAlignment="Center">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="4"
                                    Sprite="BlankWhiteSquare_9" Color="#B8960CFF"
                                    IsVisible="@IsTab0Active" />
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="01 " VerticalAlignment="Center" MarginLeft="6" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@Tab0Label" VerticalAlignment="Center" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>

                  </Children>
                </ListPanel>

                <!-- ── 右列：6 个 Tab 内容区（按 IsTabNActive 切换可见） ── -->
                <Widget Id="ContentArea"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                  <Children>

                    <!-- Tab 0: 功能开关 / Features -->
                    <Widget IsVisible="@IsTab0Active"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                   StackLayout.LayoutMethod="VerticalBottomToTop"
                                   DataSource="{FeaturesTab}">
                          <Children>

                            <!-- Scrollable toggle list -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                              <Children>

                                <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                 InnerPanel="FeatTab0ClipRect\FeatTab0InnerPanel"
                                                 ClipRect="FeatTab0ClipRect"
                                                 VerticalScrollbar="..\FeatTab0ScrollbarHolder\FeatTab0Scrollbar"
                                                 AutoHideScrollBars="true">
                                  <Children>
                                    <Widget Id="FeatTab0ClipRect"
                                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            ClipContents="true">
                                      <Children>
                                        <ListPanel Id="FeatTab0InnerPanel"
                                                   DataSource="{Toggles}"
                                                   WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                   VerticalAlignment="Top"
                                                   StackLayout.LayoutMethod="VerticalBottomToTop">
                                          <ItemTemplate>
                                            <STCPToggleRow />
                                          </ItemTemplate>
                                        </ListPanel>
                                      </Children>
                                    </Widget>
                                  </Children>
                                </ScrollablePanel>

                                <Widget Id="FeatTab0ScrollbarHolder"
                                        WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Right">
                                  <Children>
                                    <ScrollbarWidget Id="FeatTab0Scrollbar"
                                                     WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                                     SuggestedWidth="10"
                                                     AlignmentAxis="Vertical"
                                                     Handle="FeatTab0ScrollbarHandle"
                                                     MinValue="0" MaxValue="100">
                                      <Children>
                                        <Widget Id="FeatTab0ScrollbarHandle"
                                                WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                SuggestedWidth="10" SuggestedHeight="20"
                                                HorizontalAlignment="Center"
                                                Sprite="BlankWhiteSquare_9"
                                                Color="#B8960CFF" />
                                      </Children>
                                    </ScrollbarWidget>
                                  </Children>
                                </Widget>

                              </Children>
                            </Widget>

                            <!-- Thin gold divider -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                    SuggestedHeight="1"
                                    Sprite="BlankWhiteSquare_9" Color="#B8960CFF" AlphaFactor="0.5"
                                    MarginBottom="6" MarginTop="4" />

                            <!-- Intro2 -->
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@Intro2"
                                        MarginBottom="6" />

                            <!-- Intro1 -->
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@Intro1"
                                        MarginBottom="4" />

                            <!-- Tab title -->
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@Title"
                                        MarginBottom="6" />

                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>

                    <!-- Tab 1: 策略参数 / Strategy -->
                    <Widget IsVisible="@IsTab1Active"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@Tab1Label"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </Widget>

                    <!-- Tab 2: 兵种编制 / Composition -->
                    <Widget IsVisible="@IsTab2Active"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@Tab2Label"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </Widget>

                    <!-- Tab 3: 兵员模板 / Templates -->
                    <Widget IsVisible="@IsTab3Active"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@Tab3Label"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </Widget>

                    <!-- Tab 4: 非首府驻军 / Branches -->
                    <Widget IsVisible="@IsTab4Active"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@Tab4Label"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </Widget>

                    <!-- Tab 5: 财务 / Finance -->
                    <Widget IsVisible="@IsTab5Active"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@Tab5Label"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </Widget>

                  </Children>
                </Widget>

              </Children>
            </ListPanel>

            <!-- 3. 成功横幅（绿底） -->
            <Widget IsVisible="@HasSuccess"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                    Sprite="BlankWhiteSquare_9" Color="#1A5C1AFF" AlphaFactor="0.95"
                    MarginBottom="4">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           VerticalAlignment="Center">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                Text="@Success"
                                MarginLeft="10" MarginTop="6" MarginBottom="6" />
                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteDismissSuccess"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="32" SuggestedHeight="32"
                                  VerticalAlignment="Center" MarginRight="6">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Text="X" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <!-- 2. 警告横幅（红底） -->
            <Widget IsVisible="@HasWarning"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                    Sprite="BlankWhiteSquare_9" Color="#5C1A1AFF" AlphaFactor="0.95"
                    MarginBottom="4">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           VerticalAlignment="Center">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                Text="@Warning"
                                MarginLeft="10" MarginTop="6" MarginBottom="6" />
                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteDismissWarning"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="32" SuggestedHeight="32"
                                  VerticalAlignment="Center" MarginRight="6">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Text="X" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <!-- 1b. 金色分割线 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="2"
                    Sprite="BlankWhiteSquare_9" Color="#B8960CFF" AlphaFactor="1.0"
                    MarginBottom="6" />

            <!-- 1a. 表头（水平 ListPanel）：左侧标题 + 右侧控件 -->
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                       StackLayout.LayoutMethod="HorizontalLeftToRight"
                       VerticalAlignment="Center"
                       MarginTop="10" MarginBottom="6">
              <Children>

                <!-- 左侧：⚜ 图标 + 主标题 + 副标题 -->
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           VerticalAlignment="Center">
                  <Children>
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Text="⚜"
                                VerticalAlignment="Center"
                                MarginRight="8" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Text="@TitleText"
                                VerticalAlignment="Center"
                                MarginRight="10" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Text="@SubtitleText"
                                VerticalAlignment="Center" />
                  </Children>
                </ListPanel>

                <!-- 间隔填充：把右侧控件推到右边 -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                        SuggestedHeight="1" />

                <!-- 右侧：首府药丸 + 脏状态药丸 + 重读按钮 + 保存按钮 + 关闭按钮 -->
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           VerticalAlignment="Center">
                  <Children>

                    <!-- 药丸1：首府名称 -->
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Text="@CapitalName"
                                VerticalAlignment="Center"
                                MarginRight="12" />

                    <!-- 药丸2：脏状态 -->
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Text="@DirtyLabel"
                                VerticalAlignment="Center"
                                MarginRight="12" />

                    <!-- 重读按钮 -->
                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteReload"
                                  WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                                  SuggestedHeight="36"
                                  VerticalAlignment="Center"
                                  MarginRight="8">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Text="@ReloadLabel"
                                    MarginLeft="12" MarginRight="12" />
                      </Children>
                    </ButtonWidget>

                    <!-- 保存按钮 -->
                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteSave"
                                  WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                                  SuggestedHeight="36"
                                  VerticalAlignment="Center"
                                  MarginRight="8">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Text="@SaveLabel"
                                    MarginLeft="12" MarginRight="12" />
                      </Children>
                    </ButtonWidget>

                    <!-- 关闭按钮（右上角 X）-->
                    <ButtonWidget DoNotPassEventsToChildren="true"
                                  Command.Click="ExecuteClose"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="36" SuggestedHeight="36"
                                  VerticalAlignment="Center">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Text="X" />
                      </Children>
                    </ButtonWidget>

                  </Children>
                </ListPanel>

              </Children>
            </ListPanel>

          </Children>
        </ListPanel>

      </Children>
    </Widget>
  </Window>
</Prefab>
