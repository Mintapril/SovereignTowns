<Prefab>
  <Window>
    <!--
      一行功能开关：[标签 占满宽度] [vanilla 复选框 靠右]。
      复选框靠右镜像 IG「Smart Guard Creation Settings」行式样；
      复选框结构镜像 Native\GUI\Prefabs\Options\SPOptions\OptionItem.xml 的 BooleanOption：
      ButtonWidget(Brush=Checkbox.Empty) + 子 BrushWidget(Id=ToggleIndicator, Brush=Checkbox.Full)。
      DataSource 为 ToggleRowVM —— 绑定 @IsChecked / @Label。
    -->
    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48"
               StackLayout.LayoutMethod="HorizontalLeftToRight" VerticalAlignment="Center">
      <Children>

        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Brush="SPOptions.OptionName.Text" Text="@Label"
                    VerticalAlignment="Center" MarginRight="20" />

        <ButtonWidget DoNotPassEventsToChildren="true" ButtonType="Toggle"
                      IsSelected="@IsChecked" ToggleIndicator="ToggleIndicator"
                      UpdateChildrenStates="true"
                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="34" SuggestedHeight="34"
                      VerticalAlignment="Center"
                      Brush="SPOptions.Checkbox.Empty.Button">
          <Children>
            <BrushWidget Id="ToggleIndicator"
                         WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                         Brush="SPOptions.Checkbox.Full.Button" />
          </Children>
        </ButtonWidget>

      </Children>
    </ListPanel>
  </Window>
</Prefab>
