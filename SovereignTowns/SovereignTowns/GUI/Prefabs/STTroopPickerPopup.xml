<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <Standard.Background />

        <!-- Top title bar -->
        <Standard.TopPanel Parameter.Title="@Title" />

        <!-- Sticky filter bar -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" MarginTop="160" MarginLeft="160" MarginRight="160">
          <Children>
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" LayoutImp.LayoutMethod="HorizontalLeftToRight">
              <Children>

                <!-- Search input -->
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="320" HeightSizePolicy="StretchToParent" VerticalAlignment="Center">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" VerticalAlignment="Center" Brush="CustomBattle.SliderValue.Input" />
                    <EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" VerticalAlignment="Center" Brush="CustomBattle.SliderValue.Text" Text="@SearchText" MaxLength="40" />
                  </Children>
                </Widget>

                <!-- Tier range -->
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="220" HeightSizePolicy="StretchToParent" MarginLeft="20" VerticalAlignment="Center">
                  <Children>
                    <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="80" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="Tier" />
                    <IntegerInputTextWidget WidthSizePolicy="Fixed" SuggestedWidth="50" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginLeft="80" VerticalAlignment="Center" Brush="CustomBattle.SliderValue.Text" IntText="@FilterMinTier" MinInt="1" MaxInt="6" EnableClamp="true" MaxLength="1">
                      <Children>
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CustomBattle.SliderValue.Input" />
                      </Children>
                    </IntegerInputTextWidget>
                    <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="20" HeightSizePolicy="CoverChildren" MarginLeft="140" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="-" />
                    <IntegerInputTextWidget WidthSizePolicy="Fixed" SuggestedWidth="50" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginLeft="160" VerticalAlignment="Center" Brush="CustomBattle.SliderValue.Text" IntText="@FilterMaxTier" MinInt="1" MaxInt="6" EnableClamp="true" MaxLength="1">
                      <Children>
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CustomBattle.SliderValue.Input" />
                      </Children>
                    </IntegerInputTextWidget>
                  </Children>
                </Widget>

                <!-- Noble / common toggles -->
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="200" HeightSizePolicy="StretchToParent" MarginLeft="20" VerticalAlignment="Center">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30" VerticalAlignment="Center" Brush="SPOptions.Checkbox.Empty.Button" ButtonType="Toggle" IsSelected="@IncludeCommon" ToggleIndicator="ToggleIndicator1" UpdateChildrenStates="true">
                      <Children>
                        <ImageWidget Id="ToggleIndicator1" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" />
                      </Children>
                    </ButtonWidget>
                    <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="60" HeightSizePolicy="CoverChildren" MarginLeft="36" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="平民" />

                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30" MarginLeft="100" VerticalAlignment="Center" Brush="SPOptions.Checkbox.Empty.Button" ButtonType="Toggle" IsSelected="@IncludeNoble" ToggleIndicator="ToggleIndicator2" UpdateChildrenStates="true">
                      <Children>
                        <ImageWidget Id="ToggleIndicator2" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" />
                      </Children>
                    </ButtonWidget>
                    <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="60" HeightSizePolicy="CoverChildren" MarginLeft="136" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="贵族" />
                  </Children>
                </Widget>

                <!-- Show only selected toggle -->
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="200" HeightSizePolicy="StretchToParent" MarginLeft="40" VerticalAlignment="Center">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30" VerticalAlignment="Center" Brush="SPOptions.Checkbox.Empty.Button" ButtonType="Toggle" IsSelected="@ShowOnlySelected" ToggleIndicator="ToggleIndicator3" UpdateChildrenStates="true">
                      <Children>
                        <ImageWidget Id="ToggleIndicator3" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" />
                      </Children>
                    </ButtonWidget>
                    <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="140" HeightSizePolicy="CoverChildren" MarginLeft="36" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="仅显示已选" />
                  </Children>
                </Widget>

                <!-- Right-aligned total readout (color flips red when over target) -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                  <Children>
                    <RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="@TotalText" IsHidden="@IsOverTarget" />
                    <RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Color="#FF6060FF" Text="@TotalText" IsVisible="@IsOverTarget" />
                  </Children>
                </Widget>

              </Children>
            </ListPanel>
          </Children>
        </Widget>

        <!-- Culture-grouped troop list -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="228" MarginBottom="120" MarginLeft="160" MarginRight="160">
          <Children>

            <!-- Empty state -->
            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="未匹配任何兵种 — 调整搜索 / Tier 范围 / 平民贵族开关" IsVisible="@IsEmptyFiltered" />

            <ScrollablePanel Id="ScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" AutoHideScrollBarHandle="true" AutoHideScrollBars="false" ClipRect="MyClipRect" InnerPanel="MyClipRect\InnerList" VerticalScrollbar="..\VerticalScrollbar" IsHidden="@IsEmptyFiltered">
              <Children>
                <Widget Id="MyClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                  <Children>

                    <!-- Outer list: culture groups -->
                    <ListPanel Id="InnerList" DataSource="{CultureGroups}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="VerticalBottomToTop">
                      <ItemTemplate>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@IsGroupVisible">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="VerticalBottomToTop">
                              <Children>

                                <!-- Group header -->
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" MarginTop="14" MarginBottom="4">
                                  <Children>
                                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Brush="SPOptions.Description.Title.Text" Text="@HeaderText" />
                                    <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Bottom" Brush="SPOptions.CollapserLine" />
                                  </Children>
                                </Widget>

                                <!-- Inner list: troop rows -->
                                <ListPanel DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="VerticalBottomToTop">
                                  <ItemTemplate>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="64" IsVisible="@IsVisible">
                                      <Children>
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" LayoutImp.LayoutMethod="HorizontalLeftToRight">
                                          <Children>
                                            <!-- Character thumbnail -->
                                            <ImageIdentifierWidget DataSource="{Visual}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="60" SuggestedHeight="60" VerticalAlignment="Center" ImageId="@Id" TextureProviderName="@TextureProviderName" AdditionalArgs="@AdditionalArgs" />
                                            <!-- Tier -->
                                            <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="50" HeightSizePolicy="StretchToParent" MarginLeft="10" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="@TierText" />
                                            <!-- Role -->
                                            <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="40" HeightSizePolicy="StretchToParent" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="@RoleBadge" />
                                            <!-- Noble flag -->
                                            <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="70" HeightSizePolicy="StretchToParent" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="@NobleBadge" />
                                            <!-- Name -->
                                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" VerticalAlignment="Center" Brush="SPOptions.OptionName.Text" Text="@Name" />
                                            <!-- -10 -->
                                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="38" SuggestedHeight="30" VerticalAlignment="Center" Brush="CustomBattle.Menu.AddTroopType.Button" Command.Click="ExecuteDecrementBy10">
                                              <Children>
                                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.OptionName.Text" Text="-10" />
                                              </Children>
                                            </ButtonWidget>
                                            <!-- -1 -->
                                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="30" MarginLeft="4" VerticalAlignment="Center" Brush="CustomBattle.Menu.AddTroopType.Button" Command.Click="ExecuteDecrement">
                                              <Children>
                                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.OptionName.Text" Text="-" />
                                              </Children>
                                            </ButtonWidget>
                                            <!-- Count -->
                                            <IntegerInputTextWidget WidthSizePolicy="Fixed" SuggestedWidth="70" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginLeft="6" VerticalAlignment="Center" Brush="CustomBattle.SliderValue.Text" IntText="@Count" MinInt="0" MaxInt="500" EnableClamp="true" MaxLength="3">
                                              <Children>
                                                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CustomBattle.SliderValue.Input" />
                                              </Children>
                                            </IntegerInputTextWidget>
                                            <!-- +1 -->
                                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="30" MarginLeft="6" VerticalAlignment="Center" Brush="CustomBattle.Menu.AddTroopType.Button" Command.Click="ExecuteIncrement">
                                              <Children>
                                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.OptionName.Text" Text="+" />
                                              </Children>
                                            </ButtonWidget>
                                            <!-- +10 -->
                                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="38" SuggestedHeight="30" MarginLeft="4" VerticalAlignment="Center" Brush="CustomBattle.Menu.AddTroopType.Button" Command.Click="ExecuteIncrementBy10">
                                              <Children>
                                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.OptionName.Text" Text="+10" />
                                              </Children>
                                            </ButtonWidget>
                                            <!-- Remove (clear) -->
                                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="30" MarginLeft="14" VerticalAlignment="Center" Brush="CustomBattle.Menu.AddTroopType.Button" Command.Click="ExecuteRemove">
                                              <Children>
                                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.OptionName.Text" Text="X" />
                                              </Children>
                                            </ButtonWidget>
                                          </Children>
                                        </ListPanel>
                                      </Children>
                                    </Widget>
                                  </ItemTemplate>
                                </ListPanel>

                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </ItemTemplate>
                    </ListPanel>

                  </Children>
                </Widget>
              </Children>
            </ScrollablePanel>
            <Standard.VerticalScrollbar Id="VerticalScrollbar" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
          </Children>
        </Widget>

        <!-- Bottom buttons -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="80" VerticalAlignment="Bottom" MarginBottom="20">
          <Children>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" LayoutImp.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="50" Brush="CustomBattle.Menu.PopUp.SelectAll.Button" Command.Click="ExecuteClearAll">
                  <Children>
                    <RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CustomBattle.PopUp.Buttons.Text" Text="@ClearText" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="50" MarginLeft="20" Brush="CustomBattle.Menu.PopUp.SelectAll.Button" Command.Click="ExecuteReset">
                  <Children>
                    <RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CustomBattle.PopUp.Buttons.Text" Text="@ResetText" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="50" MarginLeft="20" Brush="CustomBattle.Menu.PopUp.SelectAll.Button" Command.Click="ExecuteCancel">
                  <Children>
                    <RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CustomBattle.PopUp.Buttons.Text" Text="@CancelText" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="50" MarginLeft="20" Brush="CustomBattle.Menu.PopUp.SelectAll.Button" Command.Click="ExecuteDone">
                  <Children>
                    <RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CustomBattle.PopUp.Buttons.Text" Text="@DoneText" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
