<Prefab>
  <Window>
    <!--
      一行数值参数：[标签+提示+重置] | [滑条] | [数值]。
      绑定 SliderRowVM：Label/Hint/ShowReset/ResetLabel/Value/Min/Max/IsDiscrete/ValueText。
      数值框为只读显示（深底子 Widget + TextWidget），不再用会渲染成白的 EditableTextWidget。
    -->
    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
               StackLayout.LayoutMethod="HorizontalLeftToRight"
               VerticalAlignment="Center" MarginTop="2" MarginBottom="8">
      <Children>

        <!-- 左：标签 + 提示 + 重置链接 -->
        <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="360"
                   StackLayout.LayoutMethod="VerticalBottomToTop" VerticalAlignment="Center"
                   MarginRight="14">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        Brush="SPOptions.OptionName.Text" Text="@Label" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        Brush="SPOptions.Slider.Value.Text" Text="@Hint" MarginTop="2" />
            <ButtonWidget DoNotPassEventsToChildren="true" Command.Click="ExecuteReset"
                          IsVisible="@ShowReset"
                          WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="2">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            Brush="SPOptions.Slider.Value.Text" Text="@ResetLabel" />
              </Children>
            </ButtonWidget>
          </Children>
        </ListPanel>

        <!-- 中：滑条 -->
        <SliderWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24"
                      VerticalAlignment="Center" MarginRight="12"
                      DoNotUpdateHandleSize="true" Filler="Filler" Handle="SliderHandle"
                      IsDiscrete="@IsDiscrete" MinValueFloat="@Min" MaxValueFloat="@Max" ValueFloat="@Value">
          <Children>
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="6" VerticalAlignment="Center"
                    Sprite="BlankWhiteSquare_9" Color="#2a2218FF" />
            <Widget Id="Filler" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="6" VerticalAlignment="Center"
                    Sprite="BlankWhiteSquare_9" Color="#c8a165FF" />
            <ImageWidget Id="SliderHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         SuggestedWidth="14" SuggestedHeight="22"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Sprite="BlankWhiteSquare_9" Color="#e6c585FF" />
          </Children>
        </SliderWidget>

        <!-- 右：数值（只读显示） -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="84" SuggestedHeight="30"
                VerticalAlignment="Center">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.55" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Brush="SPOptions.OptionName.Text" Text="@ValueText"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Children>
        </Widget>

      </Children>
    </ListPanel>
  </Window>
</Prefab>
