<Prefab>
  <Window>
    <!--
      已选兵员一行。绑定 TroopTemplateRowVM：
      Name/CultureName/TierText/TypeLabel/RatioPercent/EstimatedCount/Ratio/ExecuteRemove。
      移除按钮不设 Sprite，背景用子 Widget。
    -->
    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
               StackLayout.LayoutMethod="VerticalBottomToTop" MarginBottom="8">
      <Children>

        <!-- 顶行：名称/元信息 + 占比 + 移除 -->
        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                   VerticalAlignment="Center" MarginBottom="2">
          <Children>

            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                       StackLayout.LayoutMethod="VerticalBottomToTop" VerticalAlignment="Center">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            Brush="SPOptions.OptionName.Text" Text="@Name" />
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                           StackLayout.LayoutMethod="HorizontalLeftToRight" MarginTop="1">
                  <Children>
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Brush="SPOptions.Slider.Value.Text" Text="@CultureName"
                                VerticalAlignment="Center" MarginRight="8" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Brush="SPOptions.Slider.Value.Text" Text="@TierText"
                                VerticalAlignment="Center" MarginRight="8" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Brush="SPOptions.Slider.Value.Text" Text="@TypeLabel"
                                VerticalAlignment="Center" />
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>

            <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="100"
                       StackLayout.LayoutMethod="VerticalBottomToTop"
                       VerticalAlignment="Center" MarginRight="6">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            Brush="SPOptions.OptionName.Text" Text="@RatioPercent"
                            HorizontalAlignment="Right" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            Brush="SPOptions.Slider.Value.Text" Text="@EstimatedCount"
                            HorizontalAlignment="Right" />
              </Children>
            </ListPanel>

            <ButtonWidget DoNotPassEventsToChildren="true" Command.Click="ExecuteRemove"
                          WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26"
                          VerticalAlignment="Center" MarginRight="4">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="#7a3030FF" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Brush="SPOptions.Slider.Value.Text" Text="X"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Children>
            </ButtonWidget>

          </Children>
        </ListPanel>

        <!-- 占比滑条 -->
        <SliderWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20"
                      VerticalAlignment="Center" MarginLeft="2" MarginRight="6" MarginBottom="2"
                      DoNotUpdateHandleSize="true" Filler="TplFiller" Handle="TplHandle"
                      MinValueFloat="0" MaxValueFloat="1" ValueFloat="@Ratio">
          <Children>
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="6" VerticalAlignment="Center"
                    Sprite="BlankWhiteSquare_9" Color="#2a2218FF" />
            <Widget Id="TplFiller" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="6" VerticalAlignment="Center"
                    Sprite="BlankWhiteSquare_9" Color="#c8a165FF" />
            <ImageWidget Id="TplHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         SuggestedWidth="14" SuggestedHeight="18"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Sprite="BlankWhiteSquare_9" Color="#e6c585FF" />
          </Children>
        </SliderWidget>

      </Children>
    </ListPanel>
  </Window>
</Prefab>
