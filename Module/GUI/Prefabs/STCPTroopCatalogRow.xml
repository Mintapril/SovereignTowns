<Prefab>
  <Window>
    <!--
      兵种名录一行。绑定 TroopRowVM：TierText/Name/CultureName/TypeGlyph/AddLabel/ExecuteToggle。
      整行是按钮；ButtonWidget 不设 Sprite，背景用子 Widget（交互控件设 Sprite 会渲染成白）。
    -->
    <ButtonWidget DoNotPassEventsToChildren="true" Command.Click="ExecuteToggle"
                  WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34"
                  MarginBottom="3">
      <Children>
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.4" />
        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                   StackLayout.LayoutMethod="HorizontalLeftToRight" VerticalAlignment="Center">
          <Children>
            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="44" HeightSizePolicy="StretchToParent"
                        Brush="SPOptions.Slider.Value.Text" Text="@TierText"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MarginLeft="6" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Brush="SPOptions.OptionName.Text" Text="@Name"
                        VerticalAlignment="Center" MarginRight="8" />
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                        Brush="SPOptions.Slider.Value.Text" Text="@CultureName"
                        VerticalAlignment="Center" MarginRight="8" />
            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="22" HeightSizePolicy="StretchToParent"
                        Brush="SPOptions.Slider.Value.Text" Text="@TypeGlyph"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MarginRight="8" />
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="80" SuggestedHeight="26"
                    VerticalAlignment="Center" MarginRight="6">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="#5a4a2aFF" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Brush="SPOptions.Slider.Value.Text" Text="@AddLabel"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Children>
            </Widget>
          </Children>
        </ListPanel>
      </Children>
    </ButtonWidget>
  </Window>
</Prefab>
