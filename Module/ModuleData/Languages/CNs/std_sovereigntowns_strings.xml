    <string id="ST_Battle_Verdict_Won" text="战斗结束" />
    <string id="ST_Msg_Battle_Report" text="[主权城镇] {PARTY_NAME} {VERDICT}：兵员 {CURRENT}/{INITIAL}，受伤 {WOUNDED}。" />
    <string id="ST_Msg_Disband_Report" text="[主权城镇] {PARTY_NAME} 回 {HOME} 解散：合并 {TROOPS} 兵入驻军，变卖物资 +{SOLD}d，退还 {REFUND}d 给 {OWNER}。" />
    <string id="ST_Msg_Destroyed_WithRefund" text="[主权城镇] {PARTY_NAME} 被 {DESTROYER} 歼灭：退还 {REFUND}d 给首府所有者。" />
    <string id="ST_Msg_Destroyed_NoRefund" text="[主权城镇] {PARTY_NAME} 被 {DESTROYER} 歼灭。" />

    <!-- 对话（玩家与本 mod 自家队伍相遇）。 -->
    <string id="ST_Dialog_PartyKind_Recruiter" text="征兵队" />
    <string id="ST_Dialog_PartyKind_Transfer" text="调拨队" />
    <string id="ST_Dialog_PartyKind_Sally" text="出击队" />
    <string id="ST_Dialog_PartyKind_Generic" text="队伍" />
    <string id="ST_Dialog_Greeting_Generic" text="我们是 {SETTLEMENT} 派出的{PARTY_KIND}，向您致意。" />
    <string id="ST_Dialog_Greeting_Patrol" text="我们是 {SETTLEMENT} 的巡逻队，向您致意。" />
    <string id="ST_Dialog_PlayerClose" text="祝你顺利。" />
