    <tag language="简体中文" />
  </tags>
  <strings>
    <!-- WebUI 语言探针。由 /api/status 解析,使网页面板按游戏语言渲染:简体中文返回 "zh"。 -->
    <string id="ST_WebUiLang" text="zh" />

    <!-- 队伍显示名。{SETTLEMENT} / {SOURCE} / {DESTINATION} 由 C# 注入。 -->
    <string id="ST_PatrolPartyName" text="巡逻队 - {SETTLEMENT}" />
    <string id="ST_RecruiterPartyName" text="征兵队 - {SETTLEMENT}" />
    <string id="ST_SallyPartyName" text="出击队 - {SETTLEMENT}" />
    <string id="ST_TransferPartyName" text="调拨队 - {SOURCE} → {DESTINATION}" />
    <string id="ST_HonorGuardPartyName" text="卫队 - {SETTLEMENT}" />
    <string id="ST_HonorGuardRecruiterName" text="卫队征兵队 - {SETTLEMENT}" />

    <!-- GameModel 修饰描述（出现在队伍详情 tooltip）。 -->
    <string id="ST_PartySpeedBonus" text="主权城镇 城镇供养的队伍 移速加成" />
    <string id="ST_PartyWageZero" text="主权城镇 城镇供养的队伍（免氏族军饷）" />
    <string id="ST_PartySizeLimit_Recruit" text="主权城镇 征兵队容量上限" />
