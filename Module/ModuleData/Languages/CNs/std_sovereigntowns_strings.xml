    <string id="ST_ClanFinanceSettlement" text="主权城镇 金库结算" />

    <!-- 城镇/城堡菜单选项。 -->
    <string id="ST_Menu_CapitalStatus_Active" text="主权城镇：当前首府 ★ ({CAPITAL})" />
    <string id="ST_Menu_CapitalStatus_Other" text="主权城镇：当前首府 = {CAPITAL}" />
    <string id="ST_Menu_SetCapital" text="主权城镇：设为首府" />
    <string id="ST_Menu_ManageHonorGuard" text="主权城镇：管理卫队" />

    <!-- 通用占位词（实体名缺失时回填）。 -->
    <string id="ST_Common_Unset" text="&lt;未设&gt;" />
    <string id="ST_Common_Unknown" text="未知" />
    <string id="ST_Common_UnknownEntity" text="&lt;未知&gt;" />
    <string id="ST_Common_CapitalOwner" text="首府所有者" />
    <string id="ST_Common_Food" text="食物" />

    <!-- 诊断菜单玩家可见消息。 -->
    <string id="ST_Msg_Capital_Changed" text="[主权城镇] 首府已切换至 '{SETTLEMENT}'。" />
    <string id="ST_Msg_Capital_ChangeFailed" text="[主权城镇] 首府切换失败 ('{SETTLEMENT}' 已是首府或不合法)。" />

    <!-- Campaign 会话 / 每日消息。 -->
    <string id="ST_Msg_DailySummary" text="[主权城镇] 今日：招募 {RECRUITED} · 调拨 {TRANSFERRED} · 巡逻 {PATROLS} · 出击 {SALLIES} · 俘虏转化 {PRISONERS}。" />
    <string id="ST_Msg_PartyBoughtFood" text="[主权城镇] {PARTY} 在 {WHERE} 采购 {UNITS} 份{ITEM}（-{COST}d）。" />

    <!-- 配置 / 模块管理消息。 -->
    <string id="ST_Msg_Config_VersionMismatch" text="[主权城镇] global.json 版本不匹配 (文件 v{FILE_VERSION}，期望 v{EXPECTED_VERSION}) — 已重置为默认，请在游戏内控制面板重新配置。" />
    <string id="ST_Msg_AiOptIn" text="[主权城镇] 已接管拥有首府的 AI 氏族驻军（招募 / 调拨 / 出击 / 俘虏 / 巡逻）；其领主不再走原版招募，改由本 Mod 征兵供给，且只招同文化兵种。" />
    <string id="ST_Msg_IncompatibleMods" text="主权城镇：检测到互斥模块（{MODS}）已启用。本 Mod 不工作。请在启动器禁用互斥模块后重启。" />

    <!-- 战斗 / 解散 / 销毁汇报（左下角消息）。 -->
    <string id="ST_Battle_Verdict_Heavy" text="损失惨重" />
